; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="balatron"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/gdunit4_coverage/plugin.cfg")

[gdunit4]

settings/test/test_discovery=true
hooks/session_hooks=Dictionary[String, bool]({
"res://addons/gdunit4_coverage/GdUnitCoverageTestSessionHook.gd": true
})

[gdunit4_coverage]

export/lcov_path="res://coverage/coverage.lcov"
filter/include_paths=PackedStringArray("res://src/")
filter/exclude_paths=PackedStringArray("res://test/", "res://addons/")
runner/gdcov_path="/home/yuchan/Projects/balatron/bin/gdcov-4.7-stable"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
